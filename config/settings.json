{
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    }
  },
  "enabledPlugins": {
    "telegram@claude-plugins-official": true
  },
  "channelsEnabled": true,
  "skipDangerousModePermissionPrompt": true,
  "disableClaudeAiConnectors": true,
  "permissions": {
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(mkfs *)",
      "Bash(dd if=/dev/zero of=/dev/*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(/data/config/.credentials.json)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "date '+Real time in Mexico City: %Y-%m-%d %H:%M (do not use Telegram UTC timestamps)'"
          }
        ]
      }
    ]
  }
}
